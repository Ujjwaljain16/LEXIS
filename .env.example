# Copy to .env and fill in. Never commit .env (it is gitignored).

# LLM (answer generation). Free-tier Gemini keys are rate-limited.
GEMINI_API_KEY=

# Vector store (Qdrant Cloud free tier works; include https:// and the port)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Citation storage (optional unless you use /v2/citations)
POSTGRES_URL=

# API access: comma-separated key:tenant pairs. Empty = every request is refused (fail-closed).
LEXIS_API_KEYS=changeme-key:local
# AUTH_DISABLED=true     # local development only: skips the key check entirely

# Server-side directory that /v2/ingest paths must live inside
INGEST_ROOT_DIR=data/uploads

# Optional quality/latency switches (defaults shown)
# RERANK_ENABLED=false         # +MRR on dev (see README ladder); costs model memory and query latency
# ANSWER_VERIFY_CLAIMS=false   # per-claim NLI check; accuracy on legal text not yet measured
# ANSWER_CONTEXT_CHUNKS=5
